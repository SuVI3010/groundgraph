# GroundGraph full-server runtime. Use `make start-lite` only as a development fallback.
FALKORDB_MODE=server
FALKORDB_LITE_PATH=.data/groundgraph.db
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
FALKORDB_GRAPH=groundgraph
FALKORDB_BROWSER_PORT=3000

PORT=5050
GROUNDGRAPH_DATA=data/scenario.json
GROUNDGRAPH_ENABLE_LLM=1
GROUNDGRAPH_AUTO_APPLY=1

# Local coordinator. Set GROUNDGRAPH_ENABLE_LLM=0 only for a deterministic fallback run.
# Set GROUNDGRAPH_AUTO_APPLY=0 for supervised, click-to-apply mode.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_SECONDS=30

# Podman pulls this official image for the full-server runtime.
FALKORDB_IMAGE=docker.io/falkordb/falkordb:6.0.0

